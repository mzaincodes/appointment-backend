# =============================================================================
#  Backend environment
# =============================================================================
#  Copy to `.env` and fill in.  Every variable below is read (and validated)
#  in src/config/env.ts — nothing else in the codebase touches process.env.
#
#      cp .env.example .env
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Port for the HTTP API. Socket.IO shares this port.
PORT=4000

# ---- Database ---------------------------------------------------------------
# PostgreSQL connection string.
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# On a default local install the user is usually your macOS/Linux username and
# no password is needed: postgresql://localhost:5432/dentist_booking
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dentist_booking

# Set to true only for a managed database that requires TLS.
DATABASE_SSL=false

# Maximum pooled connections.
DATABASE_POOL_MAX=10

# ---- Authentication ---------------------------------------------------------
# Signing secret for JWTs. MUST be replaced outside local development.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-16-chars

# Token lifetime — accepts any ms/vercel duration string (7d, 12h, 30m).
JWT_EXPIRES_IN=7d

# ---- Frontend ---------------------------------------------------------------
# Origin allowed by CORS and the Socket.IO handshake.
# Comma-separate to allow several (e.g. a phone on your LAN).
FRONTEND_URL=http://localhost:3000

# ---- AI provider ------------------------------------------------------------
# mistral | openai | local
#
# LEAVE AI_API_KEY EMPTY to run the assistant on its built-in offline provider.
# The app stays fully usable that way: the assistant still checks real
# availability and creates real appointments through the same services — it just
# routes intents with rules instead of a language model. See the README section
# "Running without an AI key".
AI_PROVIDER=mistral

# Get one at https://console.mistral.ai/api-keys  (free tier is sufficient)
AI_API_KEY=

# mistral-small-latest is fast, cheap and supports tool calling.
AI_MODEL=mistral-small-latest

# Mistral: https://api.mistral.ai/v1
# OpenAI:  https://api.openai.com/v1   (also set AI_PROVIDER=openai)
AI_BASE_URL=https://api.mistral.ai/v1

# Abort a model call that takes longer than this (ms).
AI_TIMEOUT_MS=30000

# Maximum tool-call rounds in one conversational turn, before the assistant is
# forced to answer. Keeps a confused model from looping.
AI_MAX_TOOL_ROUNDS=4

# ---- Rate limiting ----------------------------------------------------------
# Window applied to the general API and auth limiters (ms). Default 15 minutes.
RATE_LIMIT_WINDOW_MS=900000

# Requests per window, per IP, across /api.
RATE_LIMIT_MAX=300

# Failed sign-in/registration attempts per window (successes are not counted).
AUTH_RATE_LIMIT_MAX=20

# Chat messages per minute, per IP and per socket. AI calls cost money.
CHAT_RATE_LIMIT_MAX=40

# IANA timezone the clinic operates in, e.g. America/Los_Angeles.
# Leave EMPTY to use the host's timezone — which keeps a local run
# self-consistent, since the seeded appointments are generated from the
# database server's own date.
CLINIC_TIMEZONE=

# ---- Logging ----------------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=debug
